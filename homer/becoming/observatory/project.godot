config_version=5

[application]
config/name="HOMER-01 | Learning Observatory"
run/main_scene="res://observatory.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1120
window/size/viewport_height=680
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.085, 0.11, 1)
